f3dbd40\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Status<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-062552d elementor-widget elementor-widget-heading\" data-id=\"062552d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Ongoing \u00b7 annual edition<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-8f313ff e-flex e-con-boxed e-con e-parent\" data-id=\"8f313ff\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-d73cbd1 e-con-full e-flex e-con e-child\" data-id=\"d73cbd1\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-2fd236c elementor-widget elementor-widget-heading\" data-id=\"2fd236c\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Overview\n\n<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-f98524f elementor-widget elementor-widget-heading\" data-id=\"f98524f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">The Sector's <br>Annual Reckoning\n<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-99c5167 elementor-widget elementor-widget-text-editor\" data-id=\"99c5167\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p class=\"muted\">Led by the United Nations Environment Programme and the Global Alliance for Buildings and Construction, the report tracks trends in energy demand, carbon emissions, materials, policy and investment across the whole sector. It synthesises data from international agencies, national governments and research institutions, benchmarks that evidence against net-zero pathways, and sets out the priority actions that follow.<\/p><p class=\"muted\">The 2025\u20132026 edition is the tenth. It found a sector accounting for\u00a0<strong>37% of global emissions<\/strong>\u00a0and close to\u00a0<strong>half of all global material extraction<\/strong>\u00a0\u2014 still expanding faster than it is decarbonising.<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-c21c2d2 e-con-full e-flex e-con e-child\" data-id=\"c21c2d2\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-3174d76 elementor-widget elementor-widget-heading\" data-id=\"3174d76\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">The Global Status Report is the most comprehensive global assessment of how the buildings and construction sector is performing against climate goals \u2014 and, year after year, of how far short it still falls.<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-03a2188 elementor-widget elementor-widget-text-editor\" data-id=\"03a2188\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<div class=\"split reveal in\"><div><p class=\"muted\">For policymakers it is the reference point for setting building energy codes and national commitments. For industry and investors it is the yardstick that says whether the sector&#8217;s own targets are being met. That makes the analysis behind it consequential, and it is why the report is rebuilt from the underlying data every single year rather than updated at the margins.<\/p><\/div><\/div>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>UN Environment Programme \u00b7 GlobalABC Global Status Report for Buildings and Construction The flagship annual assessment of the buildings and construction sector&#8217;s progress toward global climate goals \u2014 and the benchmark that governments, industry and investors measure themselves against. Download The Report View Online Commissioned by UNEP &amp; GlobalABC Our role Lead Coordinating Author Period [&hellip;]<\/p>\n","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_angie_page":false,"footnotes":""},"class_list":["post-777","page","type-page","status-publish","hentry"],"_links":{"self":[{"href":"https:\/\/building-insights.org\/wp-json\/wp\/v2\/pages\/777","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/building-insights.org\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/building-insights.org\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/building-insights.org\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/building-insights.org\/wp-json\/wp\/v2\/comments?post=777"}],"version-history":[{"count":16,"href":"https:\/\/building-insights.org\/wp-json\/wp\/v2\/pages\/777\/revisions"}],"predecessor-version":[{"id":796,"href":"https:\/\/building-insights.org\/wp-json\/wp\/v2\/pages\/777\/revisions\/796"}],"wp:attachment":[{"href":"https:\/\/building-insights.org\/wp-json\/wp\/v2\/media?parent=777"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}